# Non-secret DCI test binding. Provision through the selected host's secret manager.
# This template does not create a host, approve a policy, or enable enforcement.
PROMISORY_APP_ID=ari:cloud:ecosystem::app/6e0430ce-9c00-425a-80c2-97b5cec1e8ae
PROMISORY_ENVIRONMENT_ID=ari:cloud:ecosystem::environment/6e0430ce-9c00-425a-80c2-97b5cec1e8ae/24550cf8-ab9d-4e6a-b46e-96df09cf2866
PROMISORY_INSTALLATION_ID=ari:cloud:ecosystem::installation/283d450f-c6c4-43aa-85fc-aa9d05a085f8
PROMISORY_CLOUD_ID=e207942a-9edf-4952-b945-2ed6ed3707a7
PROMISORY_ORGANIZATION_ID=124e5022-6eee-4717-ab65-a03899db6237
# Pin the verified revision; the policy's stable name is promisory-test-jira-due-date.
PROMISORY_AUTHORITY_POLICY_ID=457e04a4-0a1d-4f18-8bca-7a9a5df2adc8
PROMISORY_AUTHORITY_URL=https://api.decionis.com
# Identity of the runtime's authority key, already allowlisted by Decionis.
PROMISORY_EFFECT_OBSERVER_ID=c97a5168-1325-487c-94e8-e3d4b06adffd
# Map the existing DECIONIS_ENFORCE_API_KEY to this secret; do not use the policy-writing key.
PROMISORY_AUTHORITY_API_KEY=
# Independent secrets, stored only in the host and Forge secret stores as documented.
PROMISORY_REMOTE_SIGNING_KEY=
PROMISORY_CLAIM_ENCRYPTION_KEY=
# Example path: provision a private durable volume for one installation and replica.
PROMISORY_STATE_DIRECTORY=/var/lib/promisory
PROMISORY_MODE=SHADOW
PROMISORY_ENFORCEMENT_VERIFIED=false
PROMISORY_SHARE_DUE_DATE_INTENT=false
PROMISORY_SHARE_JIRA_DATE_SNAPSHOT=false
PROMISORY_PORT=8787
PROMISORY_LISTEN_HOST=0.0.0.0
